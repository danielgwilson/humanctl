{
  "name": "humanctl-renderer-vite",
  "private": true,
  "version": "0.0.1",
  "description": "Thin Electron viewport for the package-owned Humanctl interface. Build-time only; not part of the shipped npm CLI package.",
  "type": "module",
  "main": "dist-electron-vite/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron-vite dev",
    "build": "electron-vite build",
    "build:browser": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@humanctl/ui": "file:../../packages/ui",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.1",
    "electron-vite": "^5.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6"
  }
}
