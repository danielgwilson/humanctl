{
  "name": "humanctl",
  "version": "0.21.0",
  "description": "A control plane for the human bottleneck.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2",
  "bin": {
    "humanctl": "dist/bin/humanctl.js"
  },
  "files": [
    ".agents/skills/humanctl/SKILL.md",
    ".agents/skills/humanctl/agents/openai.yaml",
    "dist/bin/humanctl.js",
    "dist/lib/commands.js",
    "dist/lib/pulse.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && npm run build:lib",
    "build:lib": "tsup",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "package:check": "node scripts/package-hygiene-check.js",
    "prepare": "node scripts/install-git-hooks.mjs",
    "leak:scan": "node scripts/leak-scan.mjs --repo",
    "leak:selftest": "node scripts/leak-scan.mjs --selftest",
    "publish:check": "npm publish --dry-run --provenance --access public --foreground-scripts --json",
    "prepublishOnly": "npm run package:check",
    "cli:init": "node ./dist/bin/humanctl.js init .",
    "cli:status": "node ./dist/bin/humanctl.js status .",
    "pulse:selftest": "tsx lib/pulse.selftest.ts",
    "reader:selftest": "tsx lib/reader.selftest.ts",
    "commands:selftest": "tsx lib/commands.selftest.ts",
    "quota:selftest": "tsx lib/claude-quota.selftest.ts",
    "span:selftest": "tsx lib/span.selftest.ts",
    "sessions:table": "tsx lib/sessions.ts"
  },
  "homepage": "https://humanctl.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielgwilson/humanctl.git"
  },
  "bugs": {
    "url": "https://github.com/danielgwilson/humanctl/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents",
    "human-in-the-loop",
    "orchestration",
    "ui",
    "cli"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.1.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
